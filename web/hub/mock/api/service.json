{
  "service": {
    "kind": "launchd",
    "supported": true,
    "installed": false,
    "units": [
      {
        "name": "daemon",
        "path": "/Users/owner/Library/LaunchAgents/hive.daemon.plist",
        "present": false,
        "loaded": false
      },
      {
        "name": "hub",
        "path": "/Users/owner/Library/LaunchAgents/hive.hub.plist",
        "present": false,
        "loaded": false
      }
    ],
    "binary": "/Users/owner/.hive/bin/hive",
    "logs": "/Users/owner/.hive/logs"
  },
  "hub_is_service": false,
  "hub_port": 8787,
  "hub_url": "http://127.0.0.1:8765",
  "command": "hive service install"
}
